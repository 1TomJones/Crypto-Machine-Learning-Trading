# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trader:trader@postgres:5432/trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=trading

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Must be at least 32 chars; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-32-chars-minimum-please

# Admin user credentials (store hashed password; generate with passlib bcrypt)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$CHANGEME

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Exchange APIs ─────────────────────────────────────────────────────────────
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Notifications ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Live Trader ───────────────────────────────────────────────────────────────
TRADING_SYMBOL=BTC/USDT
TRADING_TIMEFRAME=1m
INITIAL_CAPITAL=10000.0
MODEL_ARTIFACT_PATH=/app/models

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
